{
  "name": "hireproof-ai",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "HireProof AI — evidence-based recruitment intelligence platform (development build)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "node --import ./tests/helpers/register-alias.mjs --test \"tests/*.test.js\"",
    "db:migrate": "node database/run-migrations.js",
    "db:seed": "node database/seed.js",
    "db:reset": "node database/reset.js",
    "service": "sh scripts/run-service.sh",
    "eval:search": "node --import ./tests/helpers/register-alias.mjs scripts/search-eval.js"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.2.1",
    "unpdf": "^1.3.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.14"
  }
}
