# ---------------------------------------------------------------------------
# HireProof AI — environment configuration (copy to .env.local and fill in)
# Never commit real keys. This file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Database (required for full functionality) -----------------------------
# Supabase (or any PostgreSQL 16+). Transaction-pooler form for Supabase:
#   postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Direct form:
#   postgresql://postgres:<DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hireproof
# Python FastAPI reads DATABASE_URL from its process environment. It defaults to
# sslmode=verify-full; for trusted local-only PostgreSQL without TLS, use
# postgresql://USER@127.0.0.1:5432/hireproof?sslmode=disable instead.
# TEST_DATABASE_URL=  # optional dedicated PostgreSQL test database; test writes a temporary job
# V2_DATABASE_URL=  # private V2 endpoints: dedicated restricted LOGIN (never a table owner)
# VERIFICATION_WORKER_DATABASE_URL=  # separate worker LOGIN; never the API login
# VERIFICATION_MONITOR_DATABASE_URL=  # optional monitor LOGIN; defaults to the worker LOGIN
# BOOTSTRAP_DATABASE_URL=  # separate operator LOGIN; never the API or worker login

# --- Isolated development database (local PostgreSQL only) ------------------
# Never point these at a shared or production database. The provisioning script
# refuses any name outside hireproof_dev[_<suffix>] and any non-loopback host.
#   DEV_ADMIN_URL=postgresql://USER@127.0.0.1:5432/postgres
#   npm run db:dev:provision -- --enable-verification
#   npm run db:dev:backup-check
# The script writes .env.dev.local (gitignored, mode 0600) with generated
# passwords for three separate logins: API, verification worker, and operator.
# Source it only in local shells:
#   set -a; . ./.env.dev.local; set +a

# --- Supabase project (Auth; optional — demo auth is used when unset) -------
# Dashboard → Project Settings → API Keys (publishable/anon key is safe for
# browsers by design; it is NOT a secret and grants only anon privileges).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Python V2 bearer token verification: issuer must be the trusted HTTPS
# Supabase Auth issuer (usually https://PROJECT-REF.supabase.co/auth/v1).
# The provider must publish asymmetric signing keys via its JWKS endpoint.
SUPABASE_AUTH_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Browser-safe Supabase publishable key for server-to-provider identity checks.
SUPABASE_PUBLISHABLE_KEY=
# Operator-only secrets: provision outside frontend and normal API runtime.
# BOOTSTRAP_DATABASE_URL=
# SUPABASE_BOOTSTRAP_SERVICE_KEY=
# Verification stays disabled by default. Enable it only in the isolated local
# development environment (VERIFICATION_ENABLED=true in .env.dev.local); never
# enable it in staging, production, or any shared deployment without a completed
# isolated deployment test and security review.
VERIFICATION_ENABLED=false
# Browser origin allowed to call FastAPI directly (the temporary Next.js shell).
# Comma-separated exact origins; unset means no cross-origin browser access.
# API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public base URL of the FastAPI service used by the student verification page.
# NEXT_PUBLIC_VERIFICATION_API_URL=http://127.0.0.1:8000
# Optional server-side GitHub token for the verification worker. It raises rate
# limits for bounded public-repository collection. Never expose it to the
# frontend, never prefix it with NEXT_PUBLIC_, and never log it.
# GITHUB_TOKEN=

# "supabase" = real sign-in/sign-up via GoTrue. "demo" = clearly labeled local
# demo session for offline development and automated tests.
AUTH_MODE=demo
# Public mirror of AUTH_MODE (the client-side login page can only see
# NEXT_PUBLIC_ vars). Keep the two values identical.
NEXT_PUBLIC_AUTH_MODE=demo

# --- Python AI/document service (optional; Node fallback exists) ------------
# Started with: npm run service  (default http://127.0.0.1:8000)
AI_SERVICE_URL=http://127.0.0.1:8000

# --- LLM provider (optional; without a key the app runs in demo AI mode) ----
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the chat model / embedding model if needed
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Upload limits ----------------------------------------------------------
MAX_RESUME_SIZE_MB=5
