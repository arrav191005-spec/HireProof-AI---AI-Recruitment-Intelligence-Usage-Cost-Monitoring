# ---------------------------------------------------------------------------
# HireProof AI — environment configuration (copy to .env.local and fill in)
# Never commit real keys. This file contains placeholders only.
# ---------------------------------------------------------------------------

# --- Database (required for full functionality) -----------------------------
# Supabase (or any PostgreSQL 16+). Transaction-pooler form for Supabase:
#   postgresql://postgres.<PROJECT-REF>:<DB-PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# Direct form:
#   postgresql://postgres:<DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/hireproof

# --- Supabase project (Auth; optional — demo auth is used when unset) -------
# Dashboard → Project Settings → API Keys (publishable/anon key is safe for
# browsers by design; it is NOT a secret and grants only anon privileges).
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "supabase" = real sign-in/sign-up via GoTrue. "demo" = clearly labeled local
# demo session for offline development and automated tests.
AUTH_MODE=demo
# Public mirror of AUTH_MODE (the client-side login page can only see
# NEXT_PUBLIC_ vars). Keep the two values identical.
NEXT_PUBLIC_AUTH_MODE=demo

# --- Python AI/document service (optional; Node fallback exists) ------------
# Started with: npm run service  (default http://127.0.0.1:8000)
AI_SERVICE_URL=http://127.0.0.1:8000

# --- LLM provider (optional; without a key the app runs in demo AI mode) ----
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Override the chat model / embedding model if needed
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Upload limits ----------------------------------------------------------
MAX_RESUME_SIZE_MB=5
